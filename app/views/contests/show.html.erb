<% office = @contest.office %>
<% election = @contest.ballot&.election %>
<% heading = seat_label(office) %>
<% page_meta title: "#{heading} — #{contest_kind(@contest)}",
             description: "#{pluralize(@candidates.size, 'candidate')} in the #{contest_kind(@contest)} for #{heading}, " \
                          "with their verified social media accounts." %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <nav aria-label="Breadcrumb" class="mb-6 text-sm text-ink-muted">
    <ol class="flex flex-wrap items-center gap-1">
      <li><%= link_to "Elections", elections_path, class: "hover:text-ink" %></li>
      <% if election %>
        <li aria-hidden="true">/</li>
        <li><%= link_to election.name.presence || election.full_name, election_path(election), class: "hover:text-ink" %></li>
      <% end %>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink"><%= office&.title || "Race" %></li>
    </ol>
  </nav>

  <header>
    <p class="text-sm font-medium uppercase tracking-wide text-brand-700"><%= contest_kind(@contest) %></p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight"><%= heading %></h1>
    <p class="mt-2 text-ink-muted">
      <% if @contest.date %><time datetime="<%= @contest.date.iso8601 %>"><%= l(@contest.date, format: :long) %></time> · <% end %>
      <%= pluralize(@candidates.size, "candidate") %>
    </p>

    <% if @related_contests.any? %>
      <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
        <span class="text-ink-muted"><%= @contest.contest_type == 'general' ? "Primaries for this seat:" : "Also for this seat:" %></span>
        <% @related_contests.each do |rc| %>
          <%= link_to contest_kind(rc).delete_prefix("#{rc.date&.year} "), contest_path(rc),
                      class: "rounded-full px-3 py-1 ring-1 ring-line bg-surface-raised hover:ring-brand-600 hover:text-brand-700" %>
        <% end %>
      </div>
    <% end %>
  </header>

  <div class="mt-8 grid gap-8 lg:grid-cols-3">
    <section aria-labelledby="candidates-heading" class="lg:col-span-2">
      <h2 id="candidates-heading" class="sr-only">Candidates</h2>
      <% if @candidates.any? %>
        <ul class="grid gap-4 sm:grid-cols-2">
          <% @candidates.each do |candidate| %>
            <% person = candidate.person %>
            <% accounts = person.social_media_accounts.select(&:publicly_listed?) %>
            <% party = candidate.party_at_time.presence || @contest.party %>
            <li class="flex flex-col rounded-xl border bg-surface-raised p-5 <%= Candidate::WINNING_OUTCOMES.include?(candidate.outcome) ? 'border-status-won' : 'border-line' %>">
              <div class="flex items-start gap-4">
                <%= person_avatar(person, size: "size-16", text: "text-lg", rounded: "rounded-xl") %>
                <div class="min-w-0 flex-1">
                  <h3 class="font-semibold leading-snug">
                    <%= link_to person.full_name, person_path(person), class: "hover:text-brand-700" %>
                  </h3>
                  <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                    <%= party_badge(party) %>
                    <% if candidate.incumbent %>
                      <span class="rounded px-1.5 py-0.5 text-xs font-medium ring-1 ring-line text-ink-muted">Incumbent</span>
                    <% end %>
                    <%= outcome_chip(candidate.outcome) %>
                  </div>
                </div>
              </div>

              <% if @total_votes.positive? && candidate.tally.to_i.positive? %>
                <% pct = (candidate.tally.to_f / @total_votes * 100).round(1) %>
                <div class="mt-4">
                  <div class="flex justify-between text-sm">
                    <span><%= number_with_delimiter(candidate.tally) %> votes</span>
                    <span class="font-medium"><%= pct %>%</span>
                  </div>
                  <div class="mt-1 h-2 rounded-full bg-line" aria-hidden="true">
                    <div class="h-2 rounded-full bg-brand-600" style="width: <%= pct %>%"></div>
                  </div>
                </div>
              <% end %>

              <div class="mt-4 border-t border-line pt-3">
                <% if accounts.any? %>
                  <ul class="flex flex-wrap gap-2" aria-label="Verified social media accounts">
                    <% accounts.each do |account| %>
                      <li>
                        <%= link_to account.url, target: "_blank", rel: "noopener",
                                    title: [platform_name(account.platform), display_handle(account), channel_label(account.channel_type)].compact.join(" · "),
                                    class: "inline-flex size-9 items-center justify-center rounded-lg ring-1 ring-line hover:ring-brand-600" do %>
                          <%= platform_icon(account.platform, size: 18) %>
                          <span class="sr-only"><%= platform_name(account.platform) %> <%= display_handle(account) %> (opens in a new tab)</span>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <p class="text-xs text-ink-faint">No verified social media accounts yet</p>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="rounded-xl border border-dashed border-line p-6 text-sm text-ink-muted">No candidates on file for this race yet.</p>
      <% end %>
      <p class="mt-4 text-xs text-ink-faint">
        Order: winners first, then Democrats and Republicans, then other candidates; incumbents before challengers;
        then alphabetical. The order is not a ranking or an endorsement.
      </p>
    </section>

    <aside class="space-y-6">
      <section aria-labelledby="race-heading" class="rounded-xl border border-line bg-surface-raised p-5">
        <h2 id="race-heading" class="text-sm font-semibold">About this race</h2>
        <dl class="mt-3 space-y-2 text-sm">
          <% if office %>
            <div class="flex justify-between gap-3"><dt class="text-ink-muted">Office</dt><dd class="text-right"><%= link_to office.title, office_path(office), class: "hover:text-brand-700" %></dd></div>
          <% end %>
          <% if office&.district %>
            <div class="flex justify-between gap-3"><dt class="text-ink-muted">District</dt><dd class="text-right"><%= link_to office.district.full_name, district_path(office.district), class: "hover:text-brand-700" %></dd></div>
          <% end %>
          <% if @contest.ballot&.state.present? %>
            <div class="flex justify-between gap-3"><dt class="text-ink-muted">State</dt><dd><%= link_to @contest.ballot.state, state_path(@contest.ballot.state), class: "hover:text-brand-700" %></dd></div>
          <% end %>
          <% if election %>
            <div class="flex justify-between gap-3"><dt class="text-ink-muted">Election</dt><dd class="text-right"><%= link_to election.name.presence || election.full_name, election_path(election), class: "hover:text-brand-700" %></dd></div>
          <% end %>
        </dl>
      </section>

      <section class="rounded-xl bg-brand-50 p-5 text-sm text-ink-muted">
        <h2 class="font-semibold text-ink">About this data</h2>
        <p class="mt-2">
          Candidates and outcomes come from state election offices and our research team. "On ballot" means the
          result hasn't been recorded yet.
          <%= link_to "Sources", help_data_sources_path, class: "font-medium text-brand-700 hover:text-brand-800" %>
        </p>
        <p class="mt-3"><%= updated_stamp([@contest.updated_at, *@candidates.map(&:updated_at)].compact.max) %></p>
      </section>
    </aside>
  </div>
</div>
