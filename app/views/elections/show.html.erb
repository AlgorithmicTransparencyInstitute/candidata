<% state_name = @state&.name || @election.state %>
<% title = "#{@election.year} #{state_name} #{@election.election_type} election" %>
<% race_count = @sections.values.sum(&:size) %>
<% page_meta title: title,
             description: "#{pluralize(race_count, 'race')} in the #{title}, with candidates and their verified social media accounts." %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <nav aria-label="Breadcrumb" class="mb-6 text-sm text-ink-muted">
    <ol class="flex flex-wrap items-center gap-1">
      <li><%= link_to "Elections", elections_path, class: "hover:text-ink" %></li>
      <li aria-hidden="true">/</li>
      <li><%= link_to state_name, elections_path(state: @election.state, type: @election.election_type), class: "hover:text-ink" %></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink"><%= @election.election_type.capitalize %></li>
    </ol>
  </nav>

  <header class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight"><%= title %></h1>
      <p class="mt-2 text-ink-muted">
        <% if @election.date %><time datetime="<%= @election.date.iso8601 %>"><%= l(@election.date, format: :long) %></time> · <% end %>
        <%= pluralize(race_count, "race") %>
      </p>
    </div>
    <% dates = [["Registration deadline", @election.registration_deadline],
                ["Early voting", (@election.early_voting_start && [@election.early_voting_start, @election.early_voting_end].compact.map { |d| l(d, format: :long) }.join(" – "))]]
                 .select { |_, v| v.present? } %>
    <% if dates.any? || @other_elections.any? %>
      <dl class="grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
        <% dates.each do |label, value| %>
          <div><dt class="text-ink-muted"><%= label %></dt><dd><%= value.is_a?(Date) ? l(value, format: :long) : value %></dd></div>
        <% end %>
        <% @other_elections.each do |e| %>
          <div>
            <dt class="text-ink-muted">Also in <%= state_name %></dt>
            <dd><%= link_to "#{e.election_type.capitalize} · #{l(e.date, format: :long)}", election_path(e), class: "text-brand-700 hover:text-brand-800" %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  </header>

  <% if @sections.size > 1 %>
    <nav aria-label="Sections" class="mt-6 flex flex-wrap gap-2">
      <% @sections.each do |name, contests| %>
        <a href="#<%= name.parameterize %>" class="rounded-full px-3 py-1 text-sm ring-1 ring-line hover:ring-brand-600">
          <%= name %> <span class="text-ink-faint"><%= contests.size %></span>
        </a>
      <% end %>
    </nav>
  <% end %>

  <% if @sections.empty? %>
    <p class="mt-8 rounded-xl border border-dashed border-line p-6 text-sm text-ink-muted">No races on file for this election yet.</p>
  <% end %>

  <% @sections.each do |name, contests| %>
    <section id="<%= name.parameterize %>" aria-labelledby="<%= name.parameterize %>-heading" class="mt-10 scroll-mt-6">
      <h2 id="<%= name.parameterize %>-heading" class="text-xl font-semibold"><%= name %></h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% contests.each do |contest| %>
          <li><%= render "public/race_card", contest: contest %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <p class="mt-10"><%= updated_stamp(@election.updated_at) %></p>
</div>
