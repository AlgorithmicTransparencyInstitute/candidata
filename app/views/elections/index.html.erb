<% office_label = { 'senate' => 'U.S. Senate', 'governor' => 'Governor', 'house' => 'U.S. House' } %>
<% page_meta title: "#{@year} elections#{" in #{@state.name}" if @state}",
             description: "Every #{@year} U.S. Senate, House and governor race#{" in #{@state.name}" if @state}, " \
                          "with candidates and their verified social media accounts." %>
<% filter = ->(**changes) { elections_path({ type: @type, office: @office, state: @state&.abbreviation }.merge(changes).compact_blank) } %>

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <header>
    <h1 class="text-3xl font-bold tracking-tight"><%= @year %> elections<%= " in #{@state.name}" if @state %></h1>
    <p class="mt-2 max-w-2xl text-ink-muted">
      U.S. Senate, House and governor races, with every candidate and their verified social media accounts.
    </p>
  </header>

  <!-- Filters -->
  <div class="mt-6 flex flex-col gap-4 rounded-xl border border-line bg-surface-raised p-4 lg:flex-row lg:items-center lg:justify-between">
    <nav aria-label="Election type" class="flex gap-1 rounded-lg bg-surface p-1">
      <% { 'general' => 'General election', 'primary' => 'Primaries' }.each do |key, label| %>
        <%= link_to label, filter.call(type: key, page: nil),
                    'aria-current': (@type == key ? 'page' : nil),
                    class: "rounded-md px-3 py-1.5 text-sm font-medium #{@type == key ? 'bg-surface-raised shadow-sm text-ink' : 'text-ink-muted hover:text-ink'}" %>
      <% end %>
    </nav>

    <nav aria-label="Office" class="flex flex-wrap gap-2">
      <%= link_to "All offices", filter.call(office: nil, page: nil), 'aria-current': (@office.nil? ? 'page' : nil),
                  class: "rounded-full px-3 py-1 text-sm ring-1 #{@office.nil? ? 'bg-brand-700 text-white ring-brand-700' : 'ring-line hover:ring-brand-600'}" %>
      <% ElectionsController::OFFICES.each do |key, category| %>
        <%= link_to filter.call(office: key, page: nil), 'aria-current': (@office == key ? 'page' : nil),
                    class: "rounded-full px-3 py-1 text-sm ring-1 #{@office == key ? 'bg-brand-700 text-white ring-brand-700' : 'ring-line hover:ring-brand-600'}" do %>
          <%= office_label[key] %> <span class="<%= @office == key ? 'text-white/80' : 'text-ink-faint' %>"><%= @office_counts[category].to_i %></span>
        <% end %>
      <% end %>
    </nav>

    <%= form_with url: elections_path, method: :get, local: true, class: "flex items-center gap-2" do %>
      <%= hidden_field_tag :type, @type %>
      <%= hidden_field_tag :office, @office if @office %>
      <label for="state-filter" class="text-sm text-ink-muted">State</label>
      <select id="state-filter" name="state" onchange="this.form.requestSubmit()"
              class="rounded-lg border-line bg-surface py-1.5 text-sm focus:border-brand-600 focus:ring-brand-600">
        <option value="">All states</option>
        <% @states.each do |s| %>
          <option value="<%= s.abbreviation %>" <%= 'selected' if @state == s %>><%= s.name %></option>
        <% end %>
      </select>
      <noscript><button type="submit" class="rounded-lg bg-brand-700 px-3 py-1.5 text-sm text-white">Go</button></noscript>
    <% end %>
  </div>

  <!-- Races -->
  <section aria-labelledby="races-heading" class="mt-8">
    <div class="flex items-baseline justify-between">
      <h2 id="races-heading" class="text-xl font-semibold">
        <%= @office ? office_label[@office] : "All races" %>
      </h2>
      <span class="text-sm text-ink-muted"><%= pluralize(@contests.total_count, "race") %></span>
    </div>

    <% if @contests.any? %>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% @contests.each do |contest| %>
          <li><%= render "public/race_card", contest: contest %></li>
        <% end %>
      </ul>
      <div class="mt-6"><%= paginate @contests, window: 2 %></div>
    <% else %>
      <p class="mt-4 rounded-xl border border-dashed border-line p-6 text-sm text-ink-muted">No races match these filters.</p>
    <% end %>
  </section>

  <!-- By state -->
  <section aria-labelledby="states-heading" class="mt-12">
    <h2 id="states-heading" class="text-xl font-semibold">Elections by state</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <% @states.each do |s| %>
        <li class="rounded-xl border border-line bg-surface-raised p-4">
          <%= link_to s.name, filter.call(state: s.abbreviation, page: nil), class: "font-medium hover:text-brand-700" %>
          <ul class="mt-2 space-y-1 text-sm">
            <% Array(@elections_by_state[s.abbreviation]).each do |e| %>
              <li class="flex justify-between gap-2">
                <%= link_to e.election_type.capitalize, election_path(e), class: "text-brand-700 hover:text-brand-800" %>
                <span class="text-ink-muted"><%= l(e.date, format: :long) if e.date %></span>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </section>
</div>
