<div data-controller="cookie-consent">
  <div data-cookie-consent-target="banner"
       role="region" aria-label="Privacy notice"
       class="hidden translate-y-full opacity-0 fixed bottom-0 left-0 right-0 z-50 transition-all duration-300 ease-in-out">
    <div class="bg-gray-900 border-t border-gray-700 shadow-2xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-indigo-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <div>
                <h3 class="text-white font-semibold mb-1">Privacy notice</h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                  We use essential cookies to keep you signed in and secure the site. We also keep a cookieless,
                  first-party log of page visits with IP addresses partly masked.
                </p>
                <p class="text-gray-300 text-sm leading-relaxed mt-2">
                  With your permission, we also use Mixpanel analytics, including session recordings, to see how
                  the site is used. Signed-in CandiData staff and researchers are always measured this way while
                  using the workspace. We never use advertising cookies.
                  <%= link_to "Learn more", help_path(anchor: "privacy"), class: "text-indigo-400 hover:text-indigo-300 underline" %>.
                </p>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-3 flex-shrink-0 w-full sm:w-auto">
            <button type="button"
                    data-action="click->cookie-consent#decline"
                    class="flex-1 sm:flex-none px-5 py-2.5 border border-gray-500 text-gray-100 hover:bg-gray-800 font-semibold rounded-lg transition-colors duration-150">
              Essential only
            </button>
            <button type="button"
                    data-action="click->cookie-consent#accept"
                    class="flex-1 sm:flex-none px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition-colors duration-150">
              Allow analytics
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
