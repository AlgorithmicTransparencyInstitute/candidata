<%# 2026 general races by state as a tile grid: one equal square per state, so
    small states stay clickable and the map keeps its proportions at any width.
    Expects by_state: { "TX" => { "U.S. Senator" => 1, ... } } and state_names. %>
<% tile = 56; gap = 4 %>
<% cols = 12; rows = 8 %>
<svg viewBox="0 0 <%= cols * tile %> <%= rows * tile %>" class="block h-auto w-full" role="group"
     aria-label="Grid map of 2026 general election races by state">
  <% PublicUiHelper::STATE_TILES.each do |abbr, (col, row)| %>
    <% style = state_race_style(by_state[abbr]) %>
    <% name = state_names[abbr] || abbr %>
    <% x = col * tile + gap / 2; y = row * tile + gap / 2; size = tile - gap %>
    <% body = capture do %>
      <title><%= name %>: <%= style[:summary] %></title>
      <rect x="<%= x %>" y="<%= y %>" width="<%= size %>" height="<%= size %>" rx="6" class="<%= style[:fill] %> transition-opacity group-hover:opacity-80" />
      <text x="<%= x + size / 2 %>" y="<%= y + (style[:marks].any? ? 23 : 31) %>" text-anchor="middle" class="<%= style[:ink] %> text-[15px] font-semibold"><%= abbr %></text>
      <% if style[:marks].any? %>
        <text x="<%= x + size / 2 %>" y="<%= y + 39 %>" text-anchor="middle" class="<%= style[:ink] %> text-[8.5px] font-medium tracking-wide max-sm:hidden" opacity="0.9"><%= style[:marks].join(' · ') %></text>
      <% end %>
    <% end %>
    <% if style[:linked] %>
      <a href="<%= elections_path(state: abbr) %>" class="group focus:outline-none [&:focus-visible>rect]:stroke-ink [&:focus-visible>rect]:stroke-2" aria-label="<%= name %>: <%= style[:summary] %>"><%= body %></a>
    <% else %>
      <g aria-label="<%= name %>: <%= style[:summary] %>" role="img"><%= body %></g>
    <% end %>
  <% end %>
</svg>
