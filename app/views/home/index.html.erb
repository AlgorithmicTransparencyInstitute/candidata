<% page_meta description: "Find U.S. elected officials and 2026 candidates, the races they're in, and their verified social media accounts." %>
<% office_label = { 'senate' => 'U.S. Senate', 'governor' => 'Governor', 'house' => 'U.S. House' } %>
<% days_out = @general_date && (@general_date - Date.current).to_i %>

<!-- Hero: find someone -->
<section class="border-b border-line bg-surface-raised">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="max-w-3xl">
      <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Who's running, who's serving, and where they post.</h1>
      <p class="mt-4 text-lg text-ink-muted">
        U.S. elected officials and <%= HomeController::YEAR %> candidates, the races they're in,
        and the social media accounts our researchers have verified as theirs.
      </p>

      <%= form_with url: search_path, method: :get, local: true, role: "search", class: "mt-8" do %>
        <label for="home-search" class="sr-only">Search people, states, races and offices</label>
        <div class="flex gap-2">
          <input id="home-search" type="search" name="q" autocomplete="off"
                 placeholder="A name, a state, or a seat like TX-8"
                 class="min-w-0 flex-1 rounded-xl border-line bg-surface px-4 py-3 text-base shadow-sm focus:border-brand-600 focus:ring-brand-600">
          <button type="submit" class="rounded-xl bg-brand-700 px-5 py-3 font-semibold text-white hover:bg-brand-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2">
            Search
          </button>
        </div>
      <% end %>
      <p class="mt-3 flex flex-wrap items-center gap-2 text-sm text-ink-muted">
        <span>Try</span>
        <% ['GA Senate', 'TX-8', 'Ohio governor', 'Pennsylvania'].each do |q| %>
          <%= link_to q, search_path(q: q), class: "rounded-full px-3 py-1 ring-1 ring-line hover:text-ink hover:ring-brand-600" %>
        <% end %>
      </p>
    </div>
  </div>
</section>

<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <% if @general_by_state.any? %>
    <!-- 2026 general election -->
    <section aria-labelledby="general-heading">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
        <h2 id="general-heading" class="text-2xl font-bold tracking-tight"><%= HomeController::YEAR %> general election</h2>
        <% if @general_date %>
          <p class="text-ink-muted">
            <time datetime="<%= @general_date.iso8601 %>"><%= l(@general_date, format: :long) %></time>
            <% if days_out.positive? %> · <span class="font-medium text-ink"><%= pluralize(days_out, "day") %> away</span><% end %>
          </p>
        <% end %>
      </div>

      <div class="mt-6 grid gap-6 lg:grid-cols-3">
        <div class="rounded-xl border border-line bg-surface-raised p-4 sm:p-6 lg:col-span-2">
          <%= render "public/state_tile_map", by_state: @general_by_state, state_names: @state_names %>
          <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-ink-muted" aria-label="Map key">
            <li class="flex items-center gap-2"><span class="size-3.5 rounded bg-brand-800"></span>Senate and governor</li>
            <li class="flex items-center gap-2"><span class="size-3.5 rounded bg-brand-600"></span>Senate or governor</li>
            <li class="flex items-center gap-2"><span class="size-3.5 rounded bg-brand-100"></span>U.S. House only</li>
            <li class="text-ink-faint">Select a state to see its races</li>
          </ul>
        </div>

        <div class="flex flex-col gap-4">
          <% ElectionsController::OFFICES.each do |key, category| %>
            <%= link_to elections_path(office: key), class: "group flex items-center justify-between rounded-xl border border-line bg-surface-raised p-5 hover:border-brand-600" do %>
              <span>
                <span class="block font-semibold group-hover:text-brand-700"><%= office_label[key] %></span>
                <span class="text-sm text-ink-muted"><%= pluralize(@general_totals[category].to_i, "race") %></span>
              </span>
              <span aria-hidden="true" class="text-ink-faint group-hover:text-brand-700">→</span>
            <% end %>
          <% end %>
          <%= link_to "All #{HomeController::YEAR} races and primaries", elections_path,
                      class: "rounded-xl bg-brand-700 px-5 py-3 text-center font-semibold text-white hover:bg-brand-800" %>
        </div>
      </div>
    </section>
  <% end %>

  <!-- What's in the data -->
  <section aria-labelledby="data-heading" class="mt-16">
    <h2 id="data-heading" class="text-2xl font-bold tracking-tight">Browse the data</h2>
    <ul class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line lg:grid-cols-4">
      <% [["Politicians", @counts[:people], people_path],
          ["In office now", @counts[:current_officeholders], people_path(current: 1)],
          ["Verified social accounts", @counts[:accounts], help_path],
          ["Offices", @counts[:offices], offices_path]].each do |label, value, path| %>
        <li class="bg-surface-raised">
          <%= link_to path, class: "group block h-full p-5 hover:bg-brand-50" do %>
            <span class="block text-2xl font-semibold tabular-nums group-hover:text-brand-700"><%= number_with_delimiter(value) %></span>
            <span class="text-sm text-ink-muted"><%= label %></span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% [["States & territories", "#{@counts[:states]} states and territories", states_path],
          ["Legislatures & bodies", "#{number_with_delimiter(@counts[:bodies])} legislatures, councils and boards", bodies_path],
          ["Districts", "#{number_with_delimiter(@counts[:districts])} electoral districts", districts_path],
          ["Parties", "#{@counts[:parties]} political parties", parties_path],
          ["About the data", "Sources, coverage and how accounts are verified", help_path],
          ["Public API", "Use CandiData as a source in your own tools", "/api/v1/openapi.json"]].each do |title, blurb, path| %>
        <li>
          <%= link_to path, class: "group flex h-full items-center justify-between gap-4 rounded-xl border border-line bg-surface-raised p-5 hover:border-brand-600" do %>
            <span>
              <span class="block font-semibold group-hover:text-brand-700"><%= title %></span>
              <span class="text-sm text-ink-muted"><%= blurb %></span>
            </span>
            <span aria-hidden="true" class="text-ink-faint group-hover:text-brand-700">→</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</div>
