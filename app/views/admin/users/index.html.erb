<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Users</h1>
    <div class="flex gap-2">
      <%= link_to new_admin_invitation_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700" do %>
        <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
        Invite Users
      <% end %>
      <%= link_to "New User", new_admin_user_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" %>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-lg shadow mb-6 p-4 space-y-3">
    <div class="flex gap-2 flex-wrap">
      <%= link_to "All roles", admin_users_path(status: @status, cohort: params[:cohort]), class: "px-4 py-2 rounded #{params[:role].blank? ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <%= link_to "Admins", admin_users_path(role: 'admin', status: @status, cohort: params[:cohort]), class: "px-4 py-2 rounded #{params[:role] == 'admin' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <%= link_to "Researchers", admin_users_path(role: 'researcher', status: @status, cohort: params[:cohort]), class: "px-4 py-2 rounded #{params[:role] == 'researcher' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
    </div>

    <%# Defaults to active: the list exists to work with current people, and
        past cohorts would otherwise crowd it out. %>
    <div class="flex gap-2 flex-wrap items-center">
      <span class="text-xs font-medium text-gray-500 uppercase tracking-wide mr-1">Status</span>
      <%= link_to "Active (#{@counts[:active]})", admin_users_path(request.query_parameters.merge(status: 'active')), class: "px-3 py-1.5 text-sm rounded #{@status == 'active' ? 'bg-green-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <%= link_to "Deactivated (#{@counts[:inactive]})", admin_users_path(request.query_parameters.merge(status: 'inactive')), class: "px-3 py-1.5 text-sm rounded #{@status == 'inactive' ? 'bg-gray-700 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <%= link_to "All", admin_users_path(request.query_parameters.merge(status: 'all')), class: "px-3 py-1.5 text-sm rounded #{@status == 'all' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>

      <% if @cohorts.any? %>
        <span class="text-xs font-medium text-gray-500 uppercase tracking-wide ml-4 mr-1">Cohort</span>
        <%= form_with url: admin_users_path, method: :get, local: true, class: "inline-flex items-center gap-2" do %>
          <%= hidden_field_tag :role, params[:role] %>
          <%= hidden_field_tag :status, @status %>
          <%= select_tag :cohort, options_for_select([['All cohorts', '']] + @cohorts.map { |c| [c, c] }, params[:cohort]),
                class: "rounded text-sm border-gray-300", onchange: "this.form.submit()" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Cohort rollover: tick a graduating group and deactivate them in one go. %>
  <%= form_with url: bulk_deactivate_admin_users_path, method: :post, local: true, id: "bulkDeactivateForm" do %>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <div class="px-6 py-3 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <input type="checkbox" id="selectAllUsers" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
          Select all shown
        </label>
        <%= submit_tag "Deactivate selected",
              id: "bulkDeactivateBtn",
              disabled: true,
              data: { confirm: "Deactivate the selected users? They keep their work history but can no longer sign in." },
              class: "px-3 py-1.5 text-sm rounded bg-gray-700 text-white hover:bg-gray-800 disabled:bg-gray-200 disabled:text-gray-400 disabled:cursor-not-allowed cursor-pointer" %>
      </div>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 w-8"></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Role</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Cohort</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Assignments</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @users.each do |user| %>
            <tr class="hover:bg-gray-50 <%= 'bg-gray-50/60' if user.deactivated? %>">
              <td class="px-4 py-4">
                <% if user.active? && user != current_user %>
                  <%= check_box_tag 'user_ids[]', user.id, false, id: "user_#{user.id}", class: "user-select rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <%= link_to user.name || user.email, admin_user_path(user), class: "#{user.deactivated? ? 'text-gray-500' : 'text-blue-600 hover:text-blue-800'} font-medium" %>
              </td>
              <td class="px-6 py-4 <%= user.deactivated? ? 'text-gray-400' : 'text-gray-600' %>"><%= user.email %></td>
              <td class="px-6 py-4">
                <span class="px-2 py-1 text-xs rounded-full <%= user.admin? ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= user.role.titleize %>
                </span>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= user.cohort.presence || '—' %></td>
              <td class="px-6 py-4">
                <%# Deactivation outranks invitation state: a deactivated user
                    can't sign in regardless of whether they ever accepted. %>
                <% if user.deactivated? %>
                  <span class="px-2 py-1 text-xs rounded-full bg-gray-200 text-gray-700"
                        title="Deactivated <%= user.deactivated_at&.strftime('%b %-d, %Y') %><%= " by #{user.deactivated_by.name.presence || user.deactivated_by.email}" if user.deactivated_by %>">
                    Deactivated
                  </span>
                <% elsif user.invitation_token.present? && !user.invitation_accepted? %>
                  <span class="px-2 py-1 text-xs rounded-full bg-yellow-100 text-yellow-800">Invited</span>
                <% else %>
                  <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">Active</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-gray-600">
                <% open_count = user.assignments.active.count %>
                <%= open_count %> active
                <% if user.deactivated? && open_count.positive? %>
                  <div class="text-xs text-amber-700 font-medium">stranded — reassign</div>
                <% end %>
              </td>
              <td class="px-6 py-4 text-right">
                <%= link_to "Edit", edit_admin_user_path(user), class: "text-blue-600 hover:text-blue-800" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <script>
    (function() {
      const selectAll = document.getElementById('selectAllUsers');
      const btn = document.getElementById('bulkDeactivateBtn');
      const boxes = () => Array.from(document.querySelectorAll('.user-select'));

      function refresh() {
        const checked = boxes().filter(b => b.checked).length;
        if (btn) {
          btn.disabled = checked === 0;
          btn.value = checked === 0 ? 'Deactivate selected' : `Deactivate ${checked} selected`;
        }
      }

      if (selectAll) {
        selectAll.addEventListener('change', () => {
          boxes().forEach(b => { b.checked = selectAll.checked; });
          refresh();
        });
      }
      boxes().forEach(b => b.addEventListener('change', refresh));
      refresh();
    })();
  </script>

  <div class="mt-4">
    <%= paginate @users %>
  </div>

  <!-- Export Invitations -->
  <% pending_count = User.where.not(invitation_token: nil).where(invitation_accepted_at: nil).count %>
  <% if pending_count > 0 %>
    <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
      <div class="flex items-start justify-between">
        <div>
          <h3 class="text-sm font-semibold text-blue-900 mb-1">Pending Invitations</h3>
          <p class="text-sm text-blue-700">
            <%= pluralize(pending_count, 'user') %> <%= pending_count == 1 ? 'has' : 'have' %> not yet accepted their invitation. Download a CSV with their invitation links to share manually if needed.
          </p>
        </div>
        <%= link_to export_invitations_admin_users_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700 ml-4" do %>
          <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          Download Invitation Links
        <% end %>
      </div>
    </div>
  <% end %>
</div>
