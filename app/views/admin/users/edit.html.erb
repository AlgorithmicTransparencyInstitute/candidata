<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to "← Back to User", admin_user_path(@user), class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <h1 class="text-3xl font-bold text-gray-900 mb-6">Edit User</h1>

  <%= form_with model: [:admin, @user], class: "bg-white rounded-lg shadow p-6" do |f| %>
    <% if @user.errors.any? %>
      <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded">
        <ul class="list-disc list-inside text-red-700 text-sm">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
      <%= f.email_field :email, class: "mt-1 block w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
      <%= f.select :role, User::ROLES.map { |r| [r.titleize, r] }, {}, class: "mt-1 block w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :cohort, "Cohort", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :cohort, placeholder: "e.g. Fall 2026", list: "cohort_options",
            class: "mt-1 block w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" %>
      <datalist id="cohort_options">
        <% User.where.not(cohort: [nil, '']).distinct.order(:cohort).pluck(:cohort).each do |c| %>
          <option value="<%= c %>"></option>
        <% end %>
      </datalist>
      <p class="mt-1 text-xs text-gray-500">Optional. Groups researchers who start and finish together, so a whole cohort can be deactivated at once.</p>
    </div>

    <div class="flex justify-end gap-3">
      <%= link_to "Cancel", admin_user_path(@user), class: "px-4 py-2 text-gray-700 hover:text-gray-900" %>
      <%= f.submit "Save Changes", class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 cursor-pointer" %>
    </div>
  <% end %>
</div>
